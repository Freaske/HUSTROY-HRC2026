{
  "version": 1,
  "author": "HUSTROY motor bench - GPIO/PWM only, no TB6612 or motor physics",
  "editor": "wokwi",
  "parts": [
    { "type": "board-esp32-devkit-c-v4", "id": "esp", "top": 80, "left": 0, "attrs": {} },
    { "type": "wokwi-resistor", "id": "r1", "top": -50, "left": 620, "attrs": { "value": "220" } },
    { "type": "wokwi-led", "id": "led1", "top": -130, "left": 650, "attrs": { "color": "green" } },
    { "type": "wokwi-text", "id": "statusLabel", "top": -175, "left": 600, "attrs": { "text": "LED STATUS\nGPIO2" } },
    { "type": "wokwi-rgb-led", "id": "motorLeft", "top": -130, "left": 270, "attrs": { "common": "cathode" } },
    { "type": "wokwi-rgb-led", "id": "motorRight", "top": -130, "left": 470, "attrs": { "common": "cathode" } },
    { "type": "wokwi-text", "id": "leftLabel", "top": -175, "left": 230, "attrs": { "text": "MOTOR TRAI / LEFT" } },
    { "type": "wokwi-text", "id": "rightLabel", "top": -175, "left": 430, "attrs": { "text": "MOTOR PHAI / RIGHT" } },
    { "type": "wokwi-text", "id": "legend", "top": 40, "left": 250, "attrs": { "text": "XANH = TIEN | DO = LUI | TAT = DUNG\nLED bao chieu lenh, khong mo phong cong suat/RPM" } },
    { "type": "wokwi-resistor", "id": "leftForwardR", "top": -50, "left": 230, "attrs": { "value": "330" } },
    { "type": "wokwi-resistor", "id": "leftReverseR", "top": -10, "left": 230, "attrs": { "value": "330" } },
    { "type": "wokwi-resistor", "id": "rightForwardR", "top": -50, "left": 430, "attrs": { "value": "330" } },
    { "type": "wokwi-resistor", "id": "rightReverseR", "top": -10, "left": 430, "attrs": { "value": "330" } },
    { "type": "wokwi-logic-analyzer", "id": "logic", "top": 180, "left": 300,
      "attrs": { "channelNames": "PWMA,AIN1,AIN2,PWMB,BIN1,BIN2,STBY,LED", "filename": "hustroy-motor-demo" } },
    { "type": "wokwi-resistor", "id": "standbyPullDown", "top": 350, "left": 200, "attrs": { "value": "10000" } }
  ],
  "connections": [
    ["esp:2", "r1:1", "green", []],
    ["r1:2", "led1:A", "green", []],
    ["led1:C", "esp:GND.1", "black", []],
    ["esp:13", "leftForwardR:1", "green", []],
    ["leftForwardR:2", "motorLeft:G", "green", []],
    ["esp:14", "leftReverseR:1", "red", []],
    ["leftReverseR:2", "motorLeft:R", "red", []],
    ["motorLeft:COM", "esp:GND.1", "black", []],
    ["motorLeft:B", "esp:GND.1", "black", []],
    ["esp:21", "rightForwardR:1", "green", []],
    ["rightForwardR:2", "motorRight:G", "green", []],
    ["esp:22", "rightReverseR:1", "red", []],
    ["rightReverseR:2", "motorRight:R", "red", []],
    ["motorRight:COM", "esp:GND.1", "black", []],
    ["motorRight:B", "esp:GND.1", "black", []],
    ["esp:18", "logic:D0", "blue", []],
    ["esp:13", "logic:D1", "green", []],
    ["esp:14", "logic:D2", "green", []],
    ["esp:19", "logic:D3", "blue", []],
    ["esp:21", "logic:D4", "orange", []],
    ["esp:22", "logic:D5", "orange", []],
    ["esp:23", "logic:D6", "purple", []],
    ["esp:2", "logic:D7", "green", []],
    ["esp:23", "standbyPullDown:1", "purple", []],
    ["standbyPullDown:2", "esp:GND.1", "black", []],
    ["logic:GND", "esp:GND.1", "black", []]
